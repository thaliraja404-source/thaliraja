generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model restaurants {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  phone           String?
  whatsapp_number String?
  address         String?
  maps_url        String?
  opening_time    DateTime? @db.Time
  closing_time    DateTime? @db.Time
  is_open         Boolean?  @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  categories        categories[]
  menu_items        menu_items[]
  restaurant_admins restaurant_admins[]
}

model categories {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String   @db.Uuid
  name          String
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @db.Timestamptz
  emoji         String?

  restaurant restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_items menu_items[]
}

model menu_items {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String   @db.Uuid
  category_id   String   @db.Uuid
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  image_url     String?
  is_available  Boolean? @default(true)
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @db.Timestamptz
  is_veg        Boolean? @default(true)

  restaurant restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  category   categories  @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

model restaurant_admins {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid // Note: points to auth.users(id), which we won't model here directly
  restaurant_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz

  restaurant restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, restaurant_id])
}
